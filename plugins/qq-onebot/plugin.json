{
  "schema_version": 1,
  "id": "qq-onebot",
  "name": "QQ OneBot 平台",
  "summary": "正向文本 WebSocket、可信账号核验与明确发送收据。",
  "category": "channel",
  "version": "0.1.0",
  "requires": {
    "sdk": ">=0.15,<0.17"
  },
  "dependencies": {},
  "conflicts": [],
  "entry": "plugin:Plugin",
  "priority": 100,
  "config_writable": ["emoji_ids"],
  "contributes": {
    "smoke_driver": {"factory": "create_smoke_driver"},
    "cli_commands": [
      {
        "name": "emoji-capture",
        "help": "采集任务表情编号",
        "args": {
          "type": "object",
          "properties": {
            "companion": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+(?![\\s\\S])"},
            "seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 180}
          },
          "required": ["companion"],
          "additionalProperties": false
        },
        "handler": "capture_cli"
      }
    ],
    "channel": {
      "factory": "create_channel",
      "platform": "qq"
    },
    "api_routes": [
      {
        "method": "GET",
        "path": "/plugins/qq-onebot/config/proposal",
        "handler": "config_proposal",
        "audit": false
      },
      {
        "method": "POST",
        "path": "/plugins/qq-onebot/emoji/start",
        "handler": "capture_start",
        "audit": true
      },
      {
        "method": "GET",
        "path": "/plugins/qq-onebot/emoji/status",
        "handler": "capture_status",
        "audit": false
      },
      {
        "method": "POST",
        "path": "/plugins/qq-onebot/emoji/cancel",
        "handler": "capture_cancel",
        "audit": true
      }
    ]
  },
  "permissions": [
    "network"
  ],
  "config": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "pattern": "^wss?://",
        "minLength": 6
      },
      "connect_timeout_s": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 60,
        "default": 10
      },
      "request_timeout_s": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 60,
        "default": 30
      },
      "heartbeat_timeout_s": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 3600,
        "default": 60
      },
      "inbound_media": {
        "type": "object",
        "properties": {
          "allowed_hosts": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": []}
        },
        "additionalProperties": false
      },
      "reconnect_delays": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "maxItems": 20,
        "default": [
          1,
          2,
          4,
          8,
          16,
          30
        ]
      },
      "queue_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096,
        "default": 128
      },
      "max_message_bytes": {
        "type": "integer",
        "minimum": 1
      },
      "max_text_chars": {
        "type": "integer",
        "minimum": 1,
        "default": 4000
      },
      "emoji_ids": {
        "type": "object",
        "properties": {
          "👌": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "⏳": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "✅": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "❌": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "additionalProperties": false,
        "default": {}
      },
      "retcode_classes": {
        "type": "object",
        "patternProperties": {
          "^-?[0-9]+$": {
            "enum": [
              "rate_limited",
              "transient"
            ]
          }
        },
        "additionalProperties": false,
        "default": {}
      },
      "media_limits": {
        "type": "object",
        "properties": {
          "image": {
            "type": "object",
            "properties": {
              "max_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "formats": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "max_bytes",
              "formats"
            ],
            "additionalProperties": false
          },
          "audio": {
            "type": "object",
            "properties": {
              "max_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "formats": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "max_bytes",
              "formats"
            ],
            "additionalProperties": false
          },
          "video": {
            "type": "object",
            "properties": {
              "max_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "formats": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "max_bytes",
              "formats"
            ],
            "additionalProperties": false
          },
          "file": {
            "type": "object",
            "properties": {
              "max_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "formats": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "max_bytes",
              "formats"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "default": {}
      },
      "react_remove": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "url"
    ],
    "additionalProperties": false
  },
  "data": {
    "version": 1,
    "on_uninstall": "keep"
  },
  "failure_default": {}
}
