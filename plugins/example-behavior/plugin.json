{
  "schema_version": 1,
  "id": "example-behavior",
  "name": "example-behavior",
  "summary": "仅使用虚构数据验证扩展点的参考插件",
  "category": "behavior",
  "version": "0.2.0",
  "requires": {
    "sdk": ">=0.7,<0.22"
  },
  "entry": "plugin:Plugin",
  "priority": 100,
  "dependencies": {},
  "conflicts": [],
  "permissions": [],
  "contributes": {
    "behavior": {
      "before_attention": {
        "handler": "before_attention"
      },
      "attention": {
        "handler": "attention"
      }
    },
    "context_section": {
      "handler": "contribute",
      "budget_chars": 300
    },
    "schedule": [
      {
        "id": "tick",
        "every": "PT1M",
        "handler": "on_tick"
      }
    ],
    "services": [
      {
        "name": "example.state",
        "version": "1.0",
        "methods": [
          "get"
        ],
        "handler": "service"
      }
    ],
    "events": {
      "publish": [
        "example-behavior.ticked"
      ]
    }
  },
  "config": {
    "type": "object",
    "properties": {
      "quiet": {
        "type": "boolean",
        "default": false
      },
      "text": {
        "type": "string",
        "default": "示例状态"
      }
    },
    "additionalProperties": false
  },
  "data": {
    "version": 1,
    "on_uninstall": "keep"
  },
  "failure_default": {},
  "hot_reload": true
}
