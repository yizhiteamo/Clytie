{
  "schema_version": 1,
  "id": "chat-timing",
  "name": "聊天时机",
  "summary": "合并连续消息，按群内参与情况决定是否接话。",
  "category": "behavior",
  "version": "0.1.0",
  "requires": {
    "sdk": ">=0.23,<0.24"
  },
  "entry": "plugin:Plugin",
  "permissions": [],
  "contributes": {
    "behavior": {
      "message_received": {
        "handler": "incoming"
      },
      "attention": {
        "handler": "attention"
      },
      "before_send": {
        "handler": "before_send"
      }
    },
    "context_section": {
      "handler": "hint",
      "budget_chars": 100
    },
    "events": {
      "subscribe": [
        "message.received",
        "reply.sent"
      ],
      "handler": "on_event"
    },
    "api_routes": [
      {
        "method": "GET",
        "path": "/plugins/chat-timing/status",
        "handler": "status",
        "audit": false
      }
    ]
  },
  "config": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "judge": {
        "type": "string",
        "enum": [
          "model",
          "rules"
        ],
        "default": "model"
      },
      "activity": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "default": "medium"
      },
      "conversations": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "default": {}
      },
      "schedule": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "to": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "activity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "required": [
            "from",
            "to",
            "activity"
          ],
          "additionalProperties": false
        },
        "default": []
      },
      "tuning": {
        "type": "object",
        "properties": {
          "addressed_quiet": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 3
          },
          "addressed_max": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 8
          },
          "group_quiet": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 5
          },
          "group_max": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 20
          },
          "judge_interval": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 30
          },
          "follow_up_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 120
          },
          "follow_up_gap_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 10
          },
          "low_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.05
          },
          "medium_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.15
          },
          "high_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.3
          },
          "question_boost": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 2
          },
          "recent_boost": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1.5
          },
          "recent_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 300
          },
          "share_window": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 600
          },
          "half_life": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 600
          },
          "fatigue_start": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 3
          },
          "fatigue_stop": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 8
          },
          "low_scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 0.67
          },
          "high_scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1.5
          },
          "pair_rounds": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "default": 4
          },
          "fast_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 5
          },
          "ignore_wait": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 180
          },
          "backoff_start": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 900
          },
          "backoff_max": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 7200
          }
        },
        "default": {},
        "additionalProperties": false
      }
    }
  },
  "data": {
    "version": 1,
    "on_uninstall": "keep"
  },
  "failure_default": {},
  "hot_reload": true,
  "priority": 100,
  "dependencies": {},
  "conflicts": []
}
