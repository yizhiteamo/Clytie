{
  "schema_version": 1,
  "id": "desktop-notifier",
  "name": "Windows 桌面通知",
  "summary": "将 Clytie 提醒显示为本机 Windows 桌面通知。",
  "category": "notifier",
  "version": "0.3.0",
  "requires": {
    "sdk": ">=0.7,<0.23"
  },
  "entry": "plugin:Plugin",
  "priority": 100,
  "dependencies": {},
  "conflicts": [],
  "permissions": [
    "subprocess"
  ],
  "contributes": {
    "notifier": {
      "factory": "create_notifier"
    }
  },
  "config": {
    "type": "object",
    "properties": {
      "app_id": {
        "type": "string",
        "minLength": 1,
        "description": "已在 Windows 注册的应用标识。省略时使用 Windows PowerShell 的标识。"
      }
    },
    "additionalProperties": false
  },
  "data": {
    "version": 1,
    "on_uninstall": "keep"
  },
  "failure_default": {}
}
