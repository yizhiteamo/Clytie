{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "instance",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "people": {
      "type": "object",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "owner",
              "member"
            ]
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "channel": {
                  "type": "string",
                  "minLength": 1
                },
                "account": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false,
              "required": [
                "channel",
                "account"
              ]
            }
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false,
        "required": [
          "role",
          "accounts"
        ]
      }
    },
    "conversations": {
      "type": "object",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "platform_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "private",
              "group"
            ]
          },
          "scene": {
            "type": "string",
            "minLength": 1
          },
          "members_expected": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false,
        "required": [
          "channel",
          "platform_id",
          "kind",
          "scene"
        ]
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "owner_private"
          }
        },
        {
          "contains": {
            "const": "public_group"
          }
        },
        {
          "contains": {
            "const": "stranger_private"
          }
        }
      ]
    },
    "test_conversation": {
      "type": "string",
      "minLength": 1
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "plugins": {
      "type": "object",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object"
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false,
        "required": [
          "config"
        ]
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 6.5535e4
        },
        "session_idle_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "reauth_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "login_lockout": {
          "type": "object",
          "properties": {
            "failures": {
              "type": "integer",
              "minimum": 3,
              "maximum": 20
            },
            "seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 3600
            }
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "accounts": {
      "type": "object",
      "patternProperties": {
        "^x-": {},
        "^(?!x-).+$": {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "account": {
              "type": "string",
              "minLength": 1
            },
            "secret": {
              "type": "string",
              "minLength": 1
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false,
          "required": [
            "channel",
            "account"
          ]
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_task_seconds": {
          "type": "integer",
          "default": 3600,
          "minimum": 60,
          "maximum": 8.6400e+04
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "supervisor": {
      "type": "object",
      "properties": {
        "startup_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600,
          "default": 300
        },
        "heartbeat_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 5
        },
        "hang_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600,
          "default": 30
        },
        "restart": {
          "type": "object",
          "properties": {
            "backoff_seconds": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1,
              "maxItems": 10,
              "default": [
                10,
                30,
                60,
                120,
                300
              ]
            },
            "max_failures": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 5
            },
            "stable_seconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 8.6400e+04,
              "default": 600
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x-": {}
          }
        },
        "stop": {
          "type": "object",
          "properties": {
            "delivery_wait_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600,
              "default": 30
            },
            "task_mode": {
              "type": "string",
              "enum": [
                "cancel",
                "wait"
              ],
              "default": "cancel"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 10,
              "maximum": 3600,
              "default": 120
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x-": {}
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "notify": {
      "type": "object",
      "properties": {
        "plugins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "cooldown_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168,
          "default": 6
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timezone",
    "people",
    "scenes",
    "companions"
  ]
}
