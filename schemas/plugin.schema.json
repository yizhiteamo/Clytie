{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plugin",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "requires": {
      "type": "object",
      "properties": {
        "sdk": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "required": [
        "sdk"
      ]
    },
    "dependencies": {
      "type": "object",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false,
        "required": [
          "version"
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "entry": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "priority": {
      "type": "integer",
      "default": 100
    },
    "contributes": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "when_not_to_use": {
                "type": "string",
                "minLength": 1
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "string"
                    },
                    "call": {
                      "type": "boolean"
                    },
                    "note": {
                      "type": "string"
                    }
                  },
                  "patternProperties": {
                    "^x-": {}
                  },
                  "additionalProperties": false,
                  "required": [
                    "input",
                    "call"
                  ]
                }
              },
              "parameters": {
                "type": "object"
              }
            },
            "patternProperties": {
              "^x-": {}
            },
            "additionalProperties": false,
            "required": [
              "name",
              "description",
              "when_not_to_use",
              "examples",
              "parameters"
            ]
          }
        },
        "behavior": {
          "type": "object",
          "properties": {
            "message_received": {
              "type": "object",
              "properties": {
                "handler": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_s": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false,
              "required": [
                "handler"
              ]
            },
            "before_attention": {
              "type": "object",
              "properties": {
                "handler": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_s": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false,
              "required": [
                "handler"
              ]
            },
            "attention": {
              "type": "object",
              "properties": {
                "handler": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_s": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false,
              "required": [
                "handler"
              ]
            },
            "after_generation": {
              "type": "object",
              "properties": {
                "handler": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_s": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false,
              "required": [
                "handler"
              ]
            },
            "before_send": {
              "type": "object",
              "properties": {
                "handler": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_s": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false,
              "required": [
                "handler"
              ]
            },
            "task_completed": {
              "type": "object",
              "properties": {
                "handler": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_s": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 10
                }
              },
              "patternProperties": {
                "^x-": {}
              },
              "additionalProperties": false,
              "required": [
                "handler"
              ]
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        },
        "context_section": {
          "type": "object",
          "properties": {
            "handler": {
              "type": "string",
              "minLength": 1
            },
            "budget_chars": {
              "type": "integer",
              "minimum": 0
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false,
          "required": [
            "handler",
            "budget_chars"
          ]
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "every": {
                "type": "string",
                "minLength": 1,
                "pattern": "^P(?=[0-9]|T[0-9])(?:[0-9]+(?:[.,][0-9]+)?W|(?:[0-9]+(?:[.,][0-9]+)?Y)?(?:[0-9]+(?:[.,][0-9]+)?M)?(?:[0-9]+(?:[.,][0-9]+)?D)?(?:T(?=[0-9])(?:[0-9]+(?:[.,][0-9]+)?H)?(?:[0-9]+(?:[.,][0-9]+)?M)?(?:[0-9]+(?:[.,][0-9]+)?S)?)?)(?![\\s\\S])"
              },
              "at": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "days": {
                "type": "array"
              },
              "handler": {
                "type": "string",
                "minLength": 1
              }
            },
            "patternProperties": {
              "^x-": {}
            },
            "additionalProperties": false,
            "required": [
              "id",
              "handler"
            ],
            "oneOf": [
              {
                "required": [
                  "every"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "at"
                      ]
                    },
                    {
                      "required": [
                        "days"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "at",
                  "days"
                ],
                "not": {
                  "required": [
                    "every"
                  ]
                }
              }
            ]
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "patternProperties": {
              "^x-": {}
            },
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "methods"
            ]
          }
        },
        "events": {
          "type": "object",
          "properties": {
            "subscribe": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "publish": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "memory.read.public",
          "memory.read.private",
          "memory.write",
          "message.proactive",
          "message.react",
          "peer",
          "model.invoke",
          "network",
          "assets.write",
          "subprocess",
          "gpu"
        ]
      },
      "uniqueItems": true
    },
    "config": {
      "type": "object"
    },
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "on_uninstall": {
          "const": "keep"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "required": [
        "version",
        "on_uninstall"
      ]
    },
    "failure_default": {
      "type": "object",
      "properties": {
        "message_received": {},
        "before_attention": {},
        "attention": {},
        "after_generation": {},
        "before_send": {},
        "task_completed": {}
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "summary",
    "category",
    "version",
    "requires",
    "entry",
    "contributes",
    "permissions",
    "config"
  ]
}
