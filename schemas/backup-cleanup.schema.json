{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clytie explicit regular backup cleanup",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "plan_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "plan_request": {
      "type": "object", "additionalProperties": false,
      "required": ["backup_ids"],
      "properties": {
        "category": {"const": "regular"},
        "backup_ids": {"$ref": "#/$defs/ids"},
        "operation_id": {"$ref": "#/$defs/plan_id"}
      }
    },
    "apply_request": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id"],
      "properties": {
        "plan_id": {"$ref": "#/$defs/plan_id"},
        "operation_id": {"$ref": "#/$defs/plan_id"}
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "group", "valid_before", "valid_after"],
      "properties": {
        "scope": {"enum": ["memory", "instance"]},
        "group": {"type": "string"},
        "valid_before": {"type": "integer", "minimum": 0},
        "valid_after": {"type": "integer", "minimum": 0}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["backup_id", "retention_layers", "lost_restore_point", "eligible", "reason", "state"],
      "properties": {
        "backup_id": {"$ref": "#/$defs/id"},
        "scope": {"enum": ["memory", "instance"]},
        "group": {"type": "string"},
        "completed_at": {"type": "string", "format": "date-time"},
        "size": {"type": "integer", "minimum": 0},
        "completeness": {"enum": ["complete", "partial"]},
        "manual": {"type": "boolean"},
        "retention_layers": {"type": "array", "uniqueItems": true, "items": {"enum": ["manual", "recent", "daily", "weekly", "monthly"]}},
        "lost_restore_point": {"type": ["object", "null"], "additionalProperties": false, "properties": {
          "scope": {"enum": ["memory", "instance"]}, "group": {"type": "string"}, "completed_at": {"type": "string", "format": "date-time"}
        }},
        "eligible": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "state": {"enum": ["not_executed", "deleting", "deleted", "blocked", "failed"]}
      }
    },
    "plan_response": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "state", "backup_ids", "eligible_ids", "items", "estimated_freed_bytes", "groups_after"],
      "properties": {
        "id": {"$ref": "#/$defs/plan_id"},
        "category": {"const": "regular"},
        "state": {"enum": ["ready", "applying", "completed", "partial", "blocked", "stopped", "recovery_blocked"]},
        "created_at": {"type": "string", "format": "date-time"},
        "reason": {"type": ["string", "null"]},
        "backup_ids": {"$ref": "#/$defs/ids"},
        "eligible_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "estimated_freed_bytes": {"type": "integer", "minimum": 0},
        "groups_after": {"type": "array", "items": {"$ref": "#/$defs/group"}}
      }
    }
  },
  "$ref": "#/$defs/plan_request"
}
