{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "companion",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "object",
      "properties": {
        "max_tool_rounds": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 8
        },
        "model_call_seconds": {
          "type": "integer",
          "default": 120,
          "minimum": 10,
          "maximum": 600
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "replies": {
      "type": "object",
      "properties": {
        "fallback_private": {
          "type": "string",
          "default": "刚刚没接上，可以再说一次吗？",
          "maxLength": 200
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "outbound": {
      "type": "object",
      "properties": {
        "style_words": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "default": []
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "protection": {
      "type": "object",
      "properties": {
        "enter_ratio": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1
        },
        "exit_ratio": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 1
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "names": {
      "type": "object",
      "properties": {
        "internal_scenes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "owner_private"
          ]
        },
        "internal": {
          "type": "string",
          "minLength": 1
        },
        "external": {
          "type": "object",
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "required": [
        "internal"
      ]
    },
    "forbidden_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "model": {
      "type": "object",
      "properties": {
        "plugin": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "required": [
        "plugin",
        "config"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "plugin": {
            "type": "string",
            "minLength": 1
          },
          "account": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "object"
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false,
        "required": [
          "plugin",
          "account",
          "config"
        ]
      }
    },
    "persona": {
      "type": "object",
      "properties": {
        "files": {
          "type": "object",
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "scenes": {
          "type": "object",
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "required": [
        "files",
        "scenes"
      ]
    },
    "permissions": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "peer": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "member": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "stranger": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "object",
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer"
          },
          "config": {
            "type": "object"
          }
        },
        "patternProperties": {
          "^x-": {}
        },
        "additionalProperties": false,
        "required": [
          "enabled",
          "config"
        ]
      }
    },
    "task_card": {
      "type": "object",
      "properties": {
        "internal": {
          "type": "string",
          "minLength": 1
        },
        "external": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "object",
          "properties": {
            "internal": {
              "type": "string",
              "minLength": 1,
              "default": "任务"
            },
            "external": {
              "type": "string",
              "minLength": 1,
              "default": "任务"
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "properties": {
        "pause_hours": {
          "type": "integer",
          "default": 24,
          "minimum": 1,
          "maximum": 168
        },
        "input_filter": {
          "type": "object",
          "properties": {
            "words": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "default": []
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "default": []
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        },
        "refusal_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 5
        },
        "window_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168,
          "default": 24
        },
        "categories": {
          "type": "object",
          "properties": {
            "romance": {
              "type": "boolean",
              "default": true
            },
            "persona_change": {
              "type": "boolean",
              "default": true
            },
            "scripted_intimacy": {
              "type": "boolean",
              "default": true
            },
            "intimate_images": {
              "type": "boolean",
              "default": true
            },
            "owner_privacy": {
              "type": "boolean",
              "default": true
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        },
        "never_publish": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "notify_owner": {
          "type": "boolean",
          "default": true
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "max_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2e5,
          "default": 2e4
        },
        "max_single_message_chars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2e4,
          "default": 2000
        },
        "material_full_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440,
          "default": 15
        },
        "material_budget_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1e5,
          "default": 6000
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "private_scenes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": [
            "owner_private"
          ]
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "retry": {
          "type": "object",
          "properties": {
            "max_attempts": {
              "type": "integer",
              "default": 3,
              "minimum": 1,
              "maximum": 5
            },
            "backoff_seconds": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 60
              },
              "maxItems": 4,
              "default": [
                2,
                5
              ]
            },
            "window_seconds": {
              "type": "integer",
              "default": 60,
              "minimum": 10,
              "maximum": 600
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        },
        "group_max_seconds": {
          "type": "integer",
          "default": 60,
          "minimum": 10,
          "maximum": 300
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "object",
      "properties": {
        "cancel_words": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10
          },
          "default": [
            "取消",
            "停",
            "停止",
            "停下",
            "别做了"
          ],
          "minItems": 1,
          "maxItems": 20
        },
        "cancel_grace_seconds": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 60
        },
        "default_deadline_seconds": {
          "type": "integer",
          "default": 600,
          "minimum": 10
        },
        "max_concurrent": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 8
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": {
        "content_retention_days": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "minimum": 1
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },
    "task_reactions": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "audience": {
          "enum": [
            "all",
            "owner"
          ],
          "default": "all"
        },
        "emojis": {
          "type": "object",
          "properties": {
            "accepted": {
              "type": "string",
              "minLength": 1,
              "default": "👌"
            },
            "running": {
              "type": "string",
              "minLength": 1,
              "default": "⏳"
            },
            "done": {
              "type": "string",
              "minLength": 1,
              "default": "✅"
            },
            "failed": {
              "type": "string",
              "minLength": 1,
              "default": "❌"
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        },
        "min_interval_seconds": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 30
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-": {}
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "names",
    "model",
    "channels",
    "persona",
    "permissions"
  ]
}
