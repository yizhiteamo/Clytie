    "key_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "needs_safekeeping",
        "acknowledged",
        "copy_verified"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "needs_safekeeping": {
          "type": "boolean"
        },
        "acknowledged": {
          "type": "boolean"
        },
        "copy_verified": {
          "type": "boolean"
        },
        "code": {
          "enum": [
            "key_missing",
            "key_invalid"
          ]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "verified_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "available": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "fingerprint",
          "verified_at"
        ]
      },
      "else": {
        "required": [
          "code"
        ]
      }
    },
    "space_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "dimension"
      ],
      "properties": {
        "code": {
          "const": "space_insufficient"
        },
        "dimension": {
          "enum": [
            "preflight_free",
            "reserve_free",
            "wal_growth",
            "temporary_budget"
          ]
        }
      }
    },
    "space_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "state",
        "estimated",
        "guaranteed",
        "source_bytes",
        "package_bytes",
        "temporary_budget_bytes",
        "wal_growth_budget_bytes",
        "reserve_bytes",
        "occupied",
        "peak_temporary_bytes",
        "peak_wal_growth_bytes",
        "volumes",
        "failure"
      ],
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/operation_id"
        },
        "state": {
          "enum": [
            "estimated",
            "monitoring",
            "blocked"
          ]
        },
        "estimated": {
          "const": true
        },
        "guaranteed": {
          "const": false
        },
        "source_bytes": {
          "$ref": "#/$defs/count"
        },
        "package_bytes": {
          "$ref": "#/$defs/count"
        },
        "temporary_budget_bytes": {
          "$ref": "#/$defs/count"
        },
        "wal_growth_budget_bytes": {
          "$ref": "#/$defs/count"
        },
        "reserve_bytes": {
          "$ref": "#/$defs/count"
        },
        "peak_temporary_bytes": {
          "$ref": "#/$defs/count"
        },
        "peak_wal_growth_bytes": {
          "$ref": "#/$defs/count"
        },
        "occupied": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "regular_repository",
            "categories",
            "old_instances"
          ],
          "properties": {
            "regular_repository": {
              "$ref": "#/$defs/usage"
            },
            "categories": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "temporary_backup_work",
                "ordinary_logs",
                "plugin_upgrade_failed_sites",
                "plugin_upgrade_snapshots",
                "ledger_failed_sites",
                "ledger_snapshots",
                "memory_migration_snapshots",
                "memory_import_snapshots",
                "memory_snapshot_metadata"
              ],
              "properties": {
                "temporary_backup_work": {
                  "$ref": "#/$defs/usage"
                },
                "ordinary_logs": {
                  "$ref": "#/$defs/usage"
                },
                "plugin_upgrade_failed_sites": {
                  "$ref": "#/$defs/usage"
                },
                "plugin_upgrade_snapshots": {
                  "$ref": "#/$defs/usage"
                },
                "ledger_failed_sites": {
                  "$ref": "#/$defs/usage"
                },
                "ledger_snapshots": {
                  "$ref": "#/$defs/usage"
                },
                "memory_migration_snapshots": {
                  "$ref": "#/$defs/usage"
                },
                "memory_import_snapshots": {
                  "$ref": "#/$defs/usage"
                },
                "memory_snapshot_metadata": {
                  "$ref": "#/$defs/usage"
                }
              }
            },
            "old_instances": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "known_bytes",
                "unknown"
              ],
              "properties": {
                "known_bytes": {
                  "$ref": "#/$defs/count"
                },
                "unknown": {
                  "$ref": "#/$defs/count"
                }
              }
            }
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "device",
              "free_bytes"
            ],
            "properties": {
              "device": {
                "type": "string"
              },
              "free_bytes": {
                "$ref": "#/$defs/count"
              }
            }
          }
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/space_failure"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "failure": {
            "$ref": "#/$defs/space_failure"
          }
        }
      },
      "else": {
        "properties": {
          "failure": {
            "type": "null"
          }
        }
      }
    },
    "space_estimates": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/space_estimate"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "reason": {
              "const": "space_evidence_unverified"
            }
          }
        }
      ]
    },
    "heavy_io": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "blockers",
        "executions",
        "observed_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "ready",
            "blocked"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "role",
              "reason",
              "check"
            ],
            "properties": {
              "operation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role": {
                "anyOf": [
                  {
                    "enum": [
                      "operation",
                      "recovery",
                      "capture",
                      "startup_recovery"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "enum": [
                  "executor_active",
                  "executor_unverified",
                  "journal_unverified",
                  "journal_executor_changed",
                  "coordination_busy",
                  "responsibility_evidence_unverified"
                ]
              },
              "check": {
                "enum": [
                  "verify_executor_identity",
                  "inspect_responsibility_evidence"
                ]
              }
            }
          }
        },
        "executions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "role",
              "state",
              "data_recovery"
            ],
            "properties": {
              "operation": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "operation",
                  "recovery",
                  "capture",
                  "startup_recovery"
                ]
              },
              "state": {
                "enum": [
                  "reserved",
                  "active",
                  "ended"
                ]
              },
              "data_recovery": {
                "const": "not_checked"
              }
            }
          }
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  },
  "$ref": "#/$defs/operation"
}
